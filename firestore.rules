rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.authProvider in ['google', 'password', 'multi'] &&
             data.emailVerified is bool &&
             data.learningLevel in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 240 &&
             data.banglaExplanations is bool &&
             data.accountStatus in ['ACTIVE', 'DEACTIVATED'] &&
             data.currentDay is int && data.currentDay >= 1 && data.currentDay <= 60 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserSession(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100 &&
             data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 30 &&
             data.authProvider in ['google', 'password', 'multi'] &&
             data.activeSession is bool &&
             data.lastActiveAt is timestamp && data.lastActiveAt <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'displayName', 'authProvider',
                         'emailVerified', 'learningLevel', 'dailyGoalMinutes',
                         'banglaExplanations', 'accountStatus', 'currentDay',
                         'streakDays', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'displayName', 'authProvider',
                         'emailVerified', 'learningLevel', 'dailyGoalMinutes',
                         'banglaExplanations', 'accountStatus', 'currentDay',
                         'streakDays', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'learningLevel', 'dailyGoalMinutes', 'banglaExplanations', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['emailVerified', 'authProvider', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['emailVerified', 'authProvider', 'displayName', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll([
                           'userId', 'deviceName', 'platform', 'authProvider',
                           'activeSession', 'lastActiveAt', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'deviceName', 'platform', 'authProvider',
                           'activeSession', 'lastActiveAt', 'createdAt'
                         ]) &&
                         isValidUserSession(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         isValidUserSession(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'deviceName', 'authProvider', 'activeSession', 'lastActiveAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
